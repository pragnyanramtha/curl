{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pass",
    "primary_owner",
    "staffed_roles",
    "escalation_works",
    "release_decision",
    "evidence",
    "issues",
    "recommendations"
  ],
  "properties": {
    "pass": {
      "type": "boolean"
    },
    "primary_owner": {
      "type": "string",
      "enum": ["workforce-orchestra", "workforce-hr", "workforce-research", "workforce-eng-manager", "workforce-code-review", "workforce-qa-release"]
    },
    "staffed_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["workforce-orchestra", "workforce-hr", "workforce-research", "workforce-eng-manager", "workforce-code-review", "workforce-qa-release"]
      }
    },
    "escalation_works": {
      "type": "boolean"
    },
    "release_decision": {
      "type": "string",
      "enum": ["ship", "no-ship", "not-applicable"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  }
}
